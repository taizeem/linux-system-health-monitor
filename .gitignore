# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Runtime logs, lockfiles, and SQLite databases (including WAL and SHM files)
logs/*.log
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite3
data/*.lock

# Temporary and OS-specific files
*.tmp
*.swp
.DS_Store
